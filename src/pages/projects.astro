---
import BaseLayout from "../layouts/BaseLayout.astro";
import HorizontalCard from "../components/HorizontalCard.astro";
---

<BaseLayout title = "Projects" sideBarActiveItemID="projects">
  <section class="py-12">
  <!-- Section Title -->
  <div class="mb-8">
    <h2 class="text-4xl font-bold text-gray-800 mb-2">Projects</h2>
    <p class="text-lg text-gray-600">
      These are the projects where I play a key role in design and development.
    </p>
  </div>

  <!-- Project Introduction Box -->
  <div class="flex flex-col md:flex-row items-center justify-between bg-[#f7f9fb] text-black px-6 py-4 rounded-lg shadow-md mb-8">
    <p class="text-base font-medium">
      I actively contribute to interdisciplinary projects combining recommender systems, LLMs, and graph-based models.
    </p>
  </div>

  <HorizontalCard
    title="CoMemTree: Collaborative Behaviour Memory for LLM-based Sequential Recommendation"
    img="/comemtree.png"
    desc="An LLM ranker scores a user's next item from two kinds of behaviour evidence: WHAT the user currently prefers (the semantic behaviour of the latest interaction window) and HOW that preference is expected to evolve, predicted by a collaborative tree learned from the behaviour sequences of training users. Behaviour memories are extracted once offline, and inference needs only one ranking call per user. Evaluated on Amazon CDs, Video Games and MovieLens-1M."
    url="https://github.com/dangkh/CMT"
    badge="On-going"
    badgeCL="bg-green-600 text-white"
  />

  <HorizontalCard
    title="SCOPE: LLM-generated User Profiles for Graph-based Recommendation"
    img="/scope.png"
    desc="Combines LightGCN collaborative embeddings with LLM-generated user-preference summaries built from two views of each user: the full interaction history, and a filtered history with high-exposure (high-degree) items removed. A conflict-aware exposure gate uses the semantic discrepancy between the two summaries to control how the views are fused into the user representation, trained with BPR loss. Evaluated on Amazon Books, MovieLens and Yelp."
    url="https://github.com/dangkh/scope"
    badge="On-going"
    badgeCL="bg-green-600 text-white"
  />

  <HorizontalCard
    title="LLM for Multimodal Recommendation"
    img="/LLMsurvey.png"
    desc="Leveraging the power of LLMs to augment data and generate embeddings for recommender systems."
    url="#"
    badge="On-going"
    badgeCL="bg-green-600 text-white"

  />
  

  <HorizontalCard
    title="Enhancing News Recommendation with Graph and LLM Prompting"
    img="/HGPrompt.png"
    desc="Leveraging the power of LLMs together with graph-based models."
    url="#"
    badge="On-going"
    badgeCL="bg-green-600 text-white"

  />

  <HorizontalCard
  title="Keyword-driven Retrieval-Augmented LLMs for Cold-start Recommendations"
  img="/kalm4rec.png"
  desc="Using LLMs to rank relevant items for cold-start users."
  url="#"
  badge="Finished"
  badgeCL="bg-orange-700 text-white"
/>

  <div class="divider my-0"></div>



<HorizontalCard
  title="Graph Attention Network for Motor Imagery Classification (2023-2024). Funded by CN-UET."
  img="/GAMI.png"
  desc="Hai-Dang Kieu"
  url="#"
  badge="Finished"
  badgeCL="bg-orange-700 text-white"
    />

<HorizontalCard
  title="EEG & Eye-Tracking Dataset of ALS Patients for Spelling Systems (2020-2023). Funded by VINIF."
  img="/EEGDATA.png"
  desc="Thi Duyen Ngo, Hai Dang Kieu, Minh Hoa Nguyen, The Hoang-Anh Nguyen, Van Mao Can, Ba Hung Nguyen, Thanh Ha Le"
  url="#"
  badge="Finished"
  badgeCL="bg-orange-700 text-white"
/>


</BaseLayout>
